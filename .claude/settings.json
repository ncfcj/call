{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-codegraph.mjs\"",
            "timeout": 10,
            "statusMessage": "Conferindo o uso do CodeGraph"
          }
        ]
      }
    ]
  }
}
