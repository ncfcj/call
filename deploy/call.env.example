# Vira /etc/call/call.env na VM (só o root lê). Troque cada PREENCHA; nunca comite os valores.
DATABASE_URL=PREENCHA
LIVEKIT_URL=PREENCHA
LIVEKIT_API_KEY=PREENCHA
LIVEKIT_API_SECRET=PREENCHA

# Já preenchidos pelo instalar.sh.
JWT_SECRET=__JWT__
WEB_ORIGIN=https://__DOMINIO__
BIND_ADDR=127.0.0.1:3000
COOKIE_SECURE=true
MESSAGE_TTL_DAYS=30
RUST_LOG=call_server=info,tower_http=info
