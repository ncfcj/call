# Copie para .env e ajuste.
DATABASE_URL=postgres://call:call@localhost:5432/call
# Separe vários com vírgula. IPv4 e IPv6: o localhost do navegador pode ir para ::1.
BIND_ADDR=127.0.0.1:3000,[::1]:3000
# Origem do client Leptos (trunk serve). Separe várias com vírgula.
WEB_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080
# Segredo dos access tokens (mínimo 32 caracteres). Em produção: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-aleatorio
# Secure no cookie de refresh. false só em desenvolvimento sem HTTPS.
COOKIE_SECURE=false
# Dias até uma mensagem ser apagada de vez (padrão 30). Diminuir apaga as mais velhas na subida.
MESSAGE_TTL_DAYS=30
RUST_LOG=call_server=debug,tower_http=info

# Voz: URL do LiveKit que os clients usam e as chaves para assinar os tokens.
# Estas são as do livekit-server --dev do docker compose.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# IP desta máquina na rede local, anunciado pelo LiveKit para a mídia (lido pelo docker compose).
# Veja com: (Get-NetIPConfiguration | Where-Object IPv4DefaultGateway).IPv4Address.IPAddress
# Com 127.0.0.1, só o Chrome conecta; o Firefox recusa candidatos ICE de loopback.
LIVEKIT_NODE_IP=127.0.0.1
# Para onde o LiveKit do docker compose manda os webhooks (padrão: este servidor na porta 3000).
# LIVEKIT_WEBHOOK_URL=http://host.docker.internal:3000/livekit/webhook
