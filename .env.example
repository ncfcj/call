# Copie para .env e ajuste.
DATABASE_URL=postgres://call:call@localhost:5432/call
BIND_ADDR=127.0.0.1:3000
# Origem do client Leptos (trunk serve). Separe várias com vírgula.
WEB_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# Segredo dos access tokens (mínimo 32 caracteres). Em produção: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-aleatorio
# Secure no cookie de refresh. false só em desenvolvimento sem HTTPS.
COOKIE_SECURE=false
RUST_LOG=call_server=debug,tower_http=info

# Fase 2 (voz): chaves do livekit-server em modo --dev
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
